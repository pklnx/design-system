{
  "name": "@pklnx/design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "pklnx design system: Carbon theme with pklnx brand, source for the claude.ai Design System artifact",
  "license": "MIT AND Apache-2.0 AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pklnx/design-system.git"
  },
  "homepage": "https://github.com/pklnx/design-system#readme",
  "bugs": {
    "url": "https://github.com/pklnx/design-system/issues"
  },
  "files": [
    "theme/pklnx-carbon.css",
    "theme/vitepress.css",
    "theme/_index.scss",
    "theme/tokens.json",
    "project/fonts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./theme/pklnx-carbon.css": "./theme/pklnx-carbon.css",
    "./theme/vitepress.css": "./theme/vitepress.css",
    "./theme": {
      "sass": "./theme/_index.scss",
      "default": "./theme/_index.scss"
    },
    "./theme/tokens.json": "./theme/tokens.json",
    "./fonts/*": "./project/fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "site": "node scripts/build_site.mjs",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "peerDependencies": {
    "@carbon/styles": "^1.118.0"
  },
  "peerDependenciesMeta": {
    "@carbon/styles": {
      "optional": true
    }
  },
  "devDependencies": {
    "@carbon/colors": "^11.61.0",
    "@carbon/icons-react": "^11.91.0",
    "@carbon/layout": "^11.62.0",
    "@carbon/react": "^1.119.0",
    "@carbon/styles": "^1.118.0",
    "@carbon/themes": "^11.84.0",
    "@carbon/type": "^11.70.0",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "^0.28.2",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.106.1"
  }
}
